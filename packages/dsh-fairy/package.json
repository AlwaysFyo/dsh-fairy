{
	"name": "dsh-fairy",
	"version": "0.1.0",
	"private": true,
	"description": "Fairy theme suite anchor: one install, one skin.json, one bundle patch that wires the Fairy plugins into a DSH profile.",
	"type": "module",
	"main": "./lib/index.js",
	"icon": "icon.svg",
	"exports": {
		".": "./lib/index.js",
		"./skin.json": "./skin.json",
		"./package.json": "./package.json"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"dependencies": {
		"dsh-fairy-visual": "^0.1.0",
		"dsh-fairy-startup": "^1.0.0",
		"dsh-balance-meter": "^0.2.0",
		"dsh-fairy-voice": "^1.0.0",
		"dsh-browser-dock": "^0.1.0"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"skin.json",
		"icon.svg"
	],
	"license": "Apache-2.0"
}
